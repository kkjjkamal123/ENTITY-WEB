---
/*
  Figure wrapper for the animated explainers.
  Every figure carries: a title, one sentence of what it shows, a data label
  (measured / schematic), optional play-pause-replay controls (mandatory when
  the animation runs longer than 2 s), and a caption slot for caveats.
  The body must render a complete poster frame without JavaScript.
*/
interface Props {
  id: string;
  title: string;
  shows: string;
  data: "measured" | "schematic";
  dataNote: string; // e.g. the source: "5-run export, 2026-07-18"
  controls?: boolean;
}
const { id, title, shows, data, dataNote, controls = true } = Astro.props;
---

<figure id={id} data-fig class="card p-4 md:p-6" aria-label={title}>
  <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2">
    <div class="min-w-0">
      <p class="microlabel">{title}</p>
      <p class="mt-1 text-[0.875rem] leading-relaxed max-w-[60ch]">{shows}</p>
    </div>
    <div class="flex items-center gap-2 shrink-0">
      <span
        class:list={[
          "chip !text-[0.625rem]",
          data === "schematic" && "!border-dashed",
        ]}
        data-on={data === "measured" || undefined}
        >{data === "measured" ? "measured" : "schematic"}</span
      >
      {
        controls && (
          <span data-fig-controls class="flex items-center gap-1">
            <button
              type="button"
              data-fig-toggle
              aria-pressed="false"
              aria-label="Pause animation"
              class="btn !py-0.5 !px-2 !text-[0.625rem] !normal-case !tracking-normal"
            >
              pause
            </button>
            <button
              type="button"
              data-fig-replay
              aria-label="Replay animation"
              class="btn !py-0.5 !px-2 !text-[0.625rem] !normal-case !tracking-normal"
            >
              replay
            </button>
          </span>
        )
      }
    </div>
  </div>

  <div class="mt-4">
    <slot />
  </div>

  <figcaption class="mt-4 border-t border-outline pt-3">
    <span
      class:list={[
        "mr-2",
        data === "schematic" ? "t-warn font-medium" : "text-dim",
      ]}>{data === "schematic" ? "Schematic:" : "Data:"}</span
    >{dataNote}
    <slot name="caption" />
  </figcaption>
</figure>

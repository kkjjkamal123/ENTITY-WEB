---
/*
  Embeds a generated benchmark plot (matplotlib PNG from benchmarks/plots/)
  with explicit dimensions and a caption. These are evidence artifacts and are
  shown as generated - they do not follow the site theme.
*/
import manifest from "../../public/plots/manifest.json";
import { withBase } from "../lib/url";

interface Props {
  file: keyof typeof manifest;
  alt: string;
  regen?: string;
}
const { file, alt, regen } = Astro.props;
const { w, h } = manifest[file];
---

<figure class="card p-3 h-full flex flex-col">
  <div class="rounded-[8px] overflow-hidden bg-white border border-outline flex items-center justify-center p-3 h-[220px] md:h-[260px]">
    <img
      src={withBase(`/plots/${file}`)}
      alt={alt}
      width={w}
      height={h}
      loading="lazy"
      decoding="async"
      tabindex="0"
      class="zoomable block max-h-full max-w-full w-auto h-auto object-contain"
    />
  </div>
  <figcaption class="mt-3 px-1">
    <slot />
    {regen && <span class="block mt-1 text-[0.6875rem] text-dim">regenerate: <code>{regen}</code></span>}
  </figcaption>
</figure>

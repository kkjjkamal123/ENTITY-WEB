---
/*
  A6 - The thermal guard.
  SCHEMATIC OF THE POLICY, NOT A MEASUREMENT: no sustained-run export exists in
  benchmarks/results/ as of 2026-07-25, so the curves illustrate the mechanism
  and say so. The policy itself is real and shipped: 0 ms delay at NONE/LIGHT,
  6 ms at MODERATE, 12 ms at SEVERE+, checked every 8th token, status cached
  1 s; Efficiency mode doubles the delay (docs/OPTIMIZATIONS.md section 0).
  ENTITY Bench's SUSTAINED mode (2/5/10 min, threads-only vs auto) exists to
  measure this for real on any phone.
*/
import Fig from "../Fig.astro";

// schematic curves: relative decode rate over 5 minutes
const W = 640;
const H = 200;
const PAD = { l: 40, r: 96, t: 14, b: 26 };
const X = (min: number) => PAD.l + (min / 5) * (W - PAD.l - PAD.r);
const Y = (rel: number) => PAD.t + (1.08 - rel) * ((H - PAD.t - PAD.b) / 0.68);

const unguardedPts: [number, number][] = [
  [0, 1.0], [1.6, 1.0], [2.0, 0.98], [2.2, 0.62], [2.45, 0.5],
  [2.7, 0.64], [2.95, 0.5], [3.2, 0.63], [3.45, 0.49], [3.7, 0.62],
  [3.95, 0.5], [4.2, 0.61], [4.5, 0.5], [4.75, 0.6], [5, 0.51],
];
const guardedPts: [number, number][] = [
  [0, 0.93], [1.5, 0.93], [3, 0.92], [5, 0.92],
];

// numeric crossover of cumulative tokens between the two schematic curves
function cumulative(pts: [number, number][], t: number): number {
  let area = 0;
  for (let i = 1; i < pts.length; i++) {
    const [t0, v0] = pts[i - 1];
    const [t1, v1] = pts[i];
    if (t <= t0) break;
    const te = Math.min(t, t1);
    const ve = v0 + ((v1 - v0) * (te - t0)) / (t1 - t0);
    area += ((v0 + ve) / 2) * (te - t0);
    if (t <= t1) break;
  }
  return area;
}
let crossover = 5;
for (let t = 2; t <= 5; t += 0.01) {
  if (cumulative(guardedPts, t) >= cumulative(unguardedPts, t)) {
    crossover = t;
    break;
  }
}
const path = (pts: [number, number][]) =>
  pts.map(([t, v], i) => `${i ? "L" : "M"}${X(t).toFixed(1)},${Y(v).toFixed(1)}`).join(" ");
---

<Fig
  id="a6"
  title="A6 - The thermal guard"
  shows="A small cooperative delay between tokens holds a flat sustained rate instead of running hot and hitting a hard throttle mid-answer; past the crossover, the guarded run has produced more total tokens."
  data="schematic"
  dataNote="Schematic of the policy, not a measurement - no sustained-run export exists in benchmarks/results/ yet. The policy is shipped and real: 0 / 6 / 12 ms by Android thermal status, every 8th token, doubled in Efficiency mode. Run ENTITY Bench's SUSTAINED mode to measure it on your phone."
>
  <div id="a6-root" class="relative">
    <svg viewBox={`0 0 ${W} ${H}`} class="w-full h-auto" role="img" aria-label="Schematic: unguarded decode rate holds high then falls off a cliff and oscillates after a hard throttle; the guarded rate runs slightly lower but flat. Cumulative tokens favour the guarded line after the crossover.">
      {[0.5, 0.75, 1.0].map((v) => (
        <>
          <line x1={PAD.l} y1={Y(v)} x2={W - PAD.r} y2={Y(v)} stroke="var(--grid)" stroke-width="1" />
          <text x={PAD.l - 6} y={Y(v) + 3} text-anchor="end" font-size="9" fill="var(--dim)">{v.toFixed(2)}</text>
        </>
      ))}
      {[0, 1, 2, 3, 4, 5].map((t) => (
        <text x={X(t)} y={H - 8} text-anchor="middle" font-size="9" fill="var(--dim)">{t}m</text>
      ))}
      <line x1={X(crossover)} y1={PAD.t} x2={X(crossover)} y2={H - PAD.b} stroke="var(--warn)" stroke-width="1.5" stroke-dasharray="3 3" />
      <text x={X(crossover) + 5} y={PAD.t + 10} font-size="9" fill="var(--warn-ink)">
        crossover ~{crossover.toFixed(1)} min
      </text>
      <text x={X(crossover) + 5} y={PAD.t + 21} font-size="8.5" fill="var(--dim)">
        cumulative tokens now favour the guard
      </text>
      <path d={path(unguardedPts)} fill="none" stroke="var(--arm-2)" stroke-width="2" stroke-linejoin="round" />
      <path d={path(guardedPts)} fill="none" stroke="var(--arm-3)" stroke-width="2" stroke-linejoin="round" />
      <text x={X(5) + 6} y={Y(0.51) + 3} font-size="9" fill="var(--dim)">unguarded</text>
      <text x={X(5) + 6} y={Y(0.92) + 3} font-size="9" fill="var(--fg)">guarded</text>
      <text x={X(1.0)} y={Y(1.0) - 6} font-size="8.5" fill="var(--dim)">hard throttle ahead</text>
      <text x={X(0.55)} y={Y(0.93) + 12} font-size="8.5" fill="var(--dim)">0-12 ms cooperative delay</text>
      <rect id="a6-wipe" x="0" y="0" width={W} height={H} fill="var(--surface)" style="transform-origin: right; transform: scaleX(0)" />
    </svg>
    <p class="mt-1 text-[0.6875rem] text-dim">
      y: decode rate relative to the cool-start rate &middot; legend: solid bright = guarded,
      solid dim = unguarded &middot; both lines schematic
    </p>
  </div>

  <p slot="caption">
    The guard is cooperative, not a scheduler control: it inserts the delay itself rather than
    changing affinity or clocks, giving the OS a recovery opportunity before a hard system
    throttle. Whether the crossover lands at this point on a given phone is exactly what the
    bench app's sustained test measures.
  </p>
</Fig>

<script>
  import { registerFig, reducedMotion } from "../../scripts/figctl";

  const root = document.getElementById("a6-root");
  if (root && !reducedMotion()) {
    const wipe = document.getElementById("a6-wipe")!;
    let anim: Animation | null = null;
    const play = () => {
      anim?.cancel();
      wipe.style.transformOrigin = "right";
      anim = wipe.animate(
        [{ transform: "scaleX(1)" }, { transform: "scaleX(0)" }],
        { duration: 2600, easing: "linear", fill: "both" }
      );
    };
    registerFig(root.closest("[data-fig]") as HTMLElement, {
      start: play,
      pause() {
        anim?.pause();
      },
      resume() {
        anim?.play();
      },
      replay: play,
    });
  }
</script>

---
import "../styles/global.css";
import fontUrl from "../fonts/jetbrains-mono-latin.woff2?url";
import { withBase } from "../lib/url";
import Header from "./Header.astro";
import Footer from "./Footer.astro";

interface Props {
  title: string;
  description: string;
  path: string; // site-absolute path of this page, e.g. "/leaderboard/"
  ogImage?: string; // public/ path, defaults to the page's generated OG image
}

const { title, description, path, ogImage } = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, "") ?? "";
const canonical = `${site}${withBase(path)}`;
const og = `${site}${withBase(ogImage ?? `/og${path.replace(/\/$/, "") || "/index"}.png`)}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase("/favicon-32.png")} />
    <link rel="icon" type="image/png" sizes="192x192" href={withBase("/favicon-192.png")} />
    <link rel="apple-touch-icon" href={withBase("/apple-touch-icon.png")} />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ENTITY" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      /* theme before first paint: stored choice wins, else OS preference */
      (function () {
        try {
          var t = localStorage.getItem("entity-theme");
          if (t === "light" || t === "dark")
            document.documentElement.setAttribute("data-theme", t);
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="skip-link">Skip to content</a>
    <Header path={path} />
    <main id="main" class="flex-1 w-full">
      <slot />
    </main>
    <Footer />
  </body>
</html>

---
/*
  Thin neutral bezel for app screenshots. Never a glossy 3D mockup.
  Wrap a <Shot /> (or any <img>) in it.
*/
interface Props {
  class?: string;
}
const { class: cls } = Astro.props;
---

<div
  class:list={[
    "rounded-[24px] border border-[#3a3a40] bg-[#161619] p-2 shadow-[0_18px_40px_-24px_rgba(0,0,0,0.7)]",
    cls,
  ]}
>
  <div class="rounded-[17px] overflow-hidden border border-black/50">
    <slot />
  </div>
</div>

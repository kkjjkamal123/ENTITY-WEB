---
import Layout from "../components/Layout.astro";
import { withBase } from "../lib/url";
---

<Layout
  title="404 - ENTITY"
  description="Page not found."
  path="/404.html"
  ogImage="/og/index.png"
>
  <section class="mx-auto max-w-[1200px] px-4 md:px-6 py-24 text-center">
    <p class="microlabel">HTTP 404</p>
    <h1 class="mt-3 text-2xl md:text-3xl font-bold">Not found - and unlike a silent kernel fallback, we tell you.</h1>
    <p class="mt-4 text-dim text-[0.875rem]">The page you asked for does not exist at this address.</p>
    <div class="mt-8 flex justify-center gap-3">
      <a href={withBase("/")} class="btn btn-solid">Overview</a>
      <a href={withBase("/leaderboard/")} class="btn">Leaderboard</a>
    </div>
  </section>
</Layout>

---
import Layout from "../components/Layout.astro";
import MetricsStrip from "../components/MetricsStrip.astro";
import A1Race from "../components/figures/A1Race.astro";
import Carousel from "../components/Carousel.astro";
import Marquee from "../components/Marquee.astro";
import PhoneFrame from "../components/PhoneFrame.astro";
import Shot from "../components/Shot.astro";
import { withBase } from "../lib/url";
import snapshot from "../data/leaderboard.json";
import { processRows, sortGroups, fmtX, type BenchRow } from "../lib/bench";

const groups = processRows(snapshot.rows as unknown as BenchRow[]);
const top3 = sortGroups(
  groups.filter((g) => !g.primary.highVariance),
  "multiplier"
).slice(0, 3);
const socCount = new Set(groups.map((g) => g.primary.soc.raw)).size;

/*
  Absolute figures first, ratio second. A percentage is the claim that is easiest to
  inflate and hardest to check: "+68%" says nothing about whether the starting point was
  fair, and it is the number a reader has to take on trust. "10.8 to 18.1 tok/s" is a
  measurement, and the ratio is then just arithmetic the reader can do themselves.

  The baseline named in every condition line is llama.cpp's own default thread count on
  this hardware, not a configuration chosen to lose - see the method note on /evidence.
*/
const stats = [
  { n: "18.1", to: 18.1, dec: 1, pre: "", suf: "", what: "tok/s decode, up from 10.8", cond: "+68% over llama.cpp's own 8-thread default, CMF Phone 1, 5 runs per arm" },
  { n: "50 J", to: 50, dec: 0, pre: "", suf: " J", what: "per 128 tokens, down from 86 J", cond: "42% less battery for the same work, unplugged, integrated from the power curve" },
  { n: "3.9 s", to: 3.9, dec: 1, pre: "", suf: " s", what: "to first token, down from 13.4 s", cond: "3.4x lower TTFT, same phone and model" },
  { n: "0", to: 0, dec: 0, pre: "", suf: "", what: "network calls while it runs", cond: "the opt-in model download is the only network touch" },
];

const marqueeWords = [
  "Fully offline",
  "arm64-v8a",
  "Adaptive threads",
  "Core pinning",
  "Tokens per watt",
  "KleidiAI-aware",
  "Runtime CPU backend",
  "Thermal-aware",
  "Open source",
];

const steps = [
  { t: "Reads the silicon", d: "Scores seven Arm CPU backends against the chip at startup and loads the fastest one it supports." },
  { t: "Derives the threads", d: "Ranks cores by live frequency, picks the decode width from the top cluster, pins it to the performance cores." },
  { t: "Proves the gain", d: "Ships the three-arm ablation - naive, threads-only, Auto - so you see which decision earned the speedup, in watts." },
];

const highlights: { slug: any; title: string; cap: string }[] = [
  {
    slug: "chat-home",
    title: "Live metrics, not vibes",
    cap: "Every reply streams with a live stats bar - token rate, time to first token, temperature, watts and tokens per watt - so you can see the phone working, not just the words.",
  },
  {
    slug: "chat-models",
    title: "A catalog that knows your phone",
    cap: "On-device files plus a download catalog that is sized and ranked for this exact SoC, with GOOD FIT / FITS and KleidiAI badges per model.",
  },
  {
    slug: "chat-model-info",
    title: "Nothing hidden about the model",
    cap: "Per-model readout: quant, KleidiAI active or not, trained context, and the running context auto-fit to your free RAM so a 3B-class model loads instead of failing.",
  },
  {
    slug: "chat-benchmark",
    title: "Benchmark the phone in-app",
    cap: "The same three-arm ablation lives inside the chat app, with a sustained thermal test and cooldown before every pass.",
  },
  {
    slug: "chat-settings-2",
    title: "Auto by default, yours to override",
    cap: "ENTITY tunes itself, but core placement, efficiency mode and every sampler stay in your hands as a setting, never an assumption.",
  },
];
---

<Layout
  title="ENTITY - adaptive on-device LLM runtime for Arm phones"
  description="Fully offline Android chat that tunes llama.cpp to the Arm CPU in the phone: 18.1 tok/s where llama.cpp's own default manages 10.8, for 42% less battery, with a public device leaderboard that proves it."
  path="/"
>
  <section class="relative mx-auto max-w-[1200px] px-4 md:px-6 pt-16 md:pt-24 pb-10 overflow-hidden">
    <div class="hero-glow" aria-hidden="true"></div>
    <p class="eyebrow hero-rise" style="animation-delay:40ms">
      Fully offline &middot; arm64-v8a &middot; Android 13+ &middot; Apache-2.0
    </p>
    <h1
      class="hero-rise mt-5 text-[2rem] md:text-[3.25rem] leading-[1.08] font-bold max-w-[18ch] tracking-tight"
      style="animation-delay:90ms"
    >
      Your phone's AI is waiting on its
      <span class="text-accent-ink">slowest cores.</span>
    </h1>
    <p
      class="hero-rise mt-6 max-w-[60ch] text-dim text-[0.9375rem] md:text-lg leading-relaxed"
      style="animation-delay:150ms"
    >
      ENTITY reads the silicon, derives the thread width, and pins the fast cluster -
      <span class="text-fg">18.1 tok/s where llama.cpp's own default manages 10.8</span>, on the
      same phone and the same model, for 42% less battery. Fully offline, and it proves which
      decision earned it.
    </p>
    <div class="hero-rise mt-8 flex flex-wrap gap-3" style="animation-delay:210ms">
      <a href={withBase("/apps/#download")} class="btn btn-solid">Download ENTITY</a>
      <a href={withBase("/leaderboard/")} class="btn">See the benchmarks</a>
      <a href="https://youtu.be/ZD_jpyBqkF8" class="btn" rel="noopener">Watch the demo</a>
    </div>

    <div class="hero-rise mt-14" style="animation-delay:280ms">
      <A1Race />
    </div>
  </section>

  <MetricsStrip />

  <section class="mx-auto max-w-[1200px] px-4 md:px-6 py-14" aria-label="Headline numbers">
    <p class="eyebrow" data-reveal>Measured, not marketed</p>
    <dl
      class="mt-5 grid grid-cols-2 lg:grid-cols-4 gap-px bg-outline border border-outline rounded-[10px] overflow-hidden"
      data-stagger="90"
    >
      {
        stats.map((s) => (
          <div class="bg-surface p-5 md:p-6 flex flex-col" data-reveal>
            {/*
              data-count-final is what the tween restores when it lands. The counter in
              Layout.astro has always read it; nothing ever wrote it, so `finalText` was
              undefined and assigning it to textContent blanked the element - every one of
              these four numbers disappeared the moment the animation finished, for every
              visitor with JavaScript. The authored string is the source of truth, so it is
              the one that has to be handed to the animation.
            */}
            <dd
              class="order-1 text-[2rem] md:text-[2.5rem] font-bold leading-none text-accent-ink tabular-nums"
              data-count-to={s.to}
              data-count-decimals={s.dec}
              data-count-prefix={s.pre}
              data-count-suffix={s.suf}
              data-count-final={s.n}
            >
              {s.n}
            </dd>
            <dt class="order-2 text-[0.8125rem] mt-2">{s.what}</dt>
            <dd class="order-3 mt-3 text-[0.6875rem] text-dim leading-relaxed">{s.cond}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="mx-auto max-w-[1200px] px-4 md:px-6 py-8">
    <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
      <div>
        <p class="eyebrow">See it running</p>
        <h2 class="mt-2 text-xl md:text-2xl font-bold">A real assistant, fully on the phone</h2>
      </div>
      <a href={withBase("/apps/")} class="btn !py-1.5 !px-3 text-[0.75rem]">All screens &rarr;</a>
    </div>
    <div class="mt-6" data-reveal>
      <Carousel id="home-shots" label="ENTITY chat screenshots">
        {
          highlights.map((s, i) => (
            <figure class="carousel__slide">
              <div class="showcase">
                <PhoneFrame class="w-full max-w-[22rem]">
                  <Shot slug={s.slug} alt={s.title} eager={i === 0} />
                </PhoneFrame>
                <figcaption>
                  <p class="eyebrow">{`Screen ${String(i + 1).padStart(2, "0")}`}</p>
                  <h3 class="mt-3 text-xl md:text-3xl font-bold leading-tight">{s.title}</h3>
                  <p class="mt-4 text-[0.9375rem] md:text-lg text-dim leading-relaxed">{s.cap}</p>
                </figcaption>
              </div>
            </figure>
          ))
        }
      </Carousel>
    </div>
  </section>

  <section class="mx-auto max-w-[1200px] px-4 md:px-6 py-8">
    <p class="eyebrow" data-reveal>Head to head</p>
    <h2 class="mt-2 text-xl md:text-2xl font-bold" data-reveal>
      Faster than Arm's own reference app, on Arm's own silicon
    </h2>
    <p class="mt-3 max-w-[68ch] text-dim text-[0.875rem]" data-reveal>
      One session, 2026-07-20. Same phone, same <code>Llama-3.2-1B-Instruct-Q4_0</code>, same
      PP 512 / TG 128 workload, each app's own benchmark screen, five runs each, 30 minute cooldown
      between apps so nobody inherits another's heat.
    </p>
    <div class="mt-5 card p-5 md:p-6 overflow-x-auto" data-reveal>
      <table class="w-full text-[0.8125rem] border-collapse">
        <thead>
          <tr class="text-dim">
            <th scope="col" class="text-left py-2">App</th>
            <th scope="col" class="text-right py-2">Prompt (tok/s)</th>
            <th scope="col" class="text-right py-2">Decode (tok/s)</th>
            <th scope="col" class="text-left py-2 pl-4">Threads</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-t border-outline">
            <td class="py-2">PocketPal AI</td>
            <td class="text-right tabular-nums">88.32</td>
            <td class="text-right tabular-nums">13.9</td>
            <td class="pl-4">6</td>
          </tr>
          <tr class="border-t border-outline">
            <td class="py-2">Arm AI Chat <span class="text-dim">(Arm's own app)</span></td>
            <td class="text-right tabular-nums">121 ± 2.99</td>
            <td class="text-right tabular-nums">12.4 ± 0.08</td>
            <td class="pl-4">not reported</td>
          </tr>
          <tr class="border-t border-outline font-bold">
            <td class="py-2">ENTITY</td>
            <td class="text-right tabular-nums">128</td>
            <td class="text-right tabular-nums">18.2</td>
            <td class="pl-4">4, pinned</td>
          </tr>
        </tbody>
      </table>
      <p class="mt-4 text-[0.875rem]">
        Against Arm AI Chat: <span class="font-bold">+6% prompt, +47% token generation.</span>
        Against PocketPal: <span class="font-bold">+45% and +31%.</span>
      </p>
      <p class="mt-2 text-[0.8125rem] text-dim leading-relaxed">
        Decode is where the thread-count policy acts, so decode is where the margin is. The prompt
        column is close because all three run Q4_0 and reach the same KleidiAI kernels - that column
        mostly measures whether an app got the quantization right, and here everyone did. The decode
        gap has a named mechanism: PocketPal runs 6 threads on a 4+4 chip, so two land on
        Cortex-A55s at roughly a third of an A78's throughput and every step waits on them.
        <a href={withBase("/evidence/#competition")}>Both sessions, screenshots and caveats</a> -
        including the July run that disagrees with this one.
      </p>
      <p class="mt-2 text-[0.8125rem] text-dim leading-relaxed">
        And the question underneath every number above: does going faster change what the model
        says? Thread count fixes the order of a floating-point reduction, so it could. Measured
        across four scheduling arms, <span class="font-bold">8 threads and the shipped 4 produce
        the same tokens byte for byte and the same twelve per-chunk perplexity values</span> -
        with a control proving the comparison can still detect a difference when there is one.
        <a href={withBase("/evidence/#equivalence")}>The equivalence measurement</a>.
      </p>
      <p class="mt-2 text-[0.8125rem] text-dim leading-relaxed">
        And the one that bounds the whole thesis: how much of this is Arm the architecture, and how
        much is Arm the <em>platform</em>? Ported to Apple silicon - also arm64 -
        <span class="font-bold">six of the ten optimizations are removed or crippled</span> - four
        gone outright (per-core clocks, deadline hints, energy, multi-variant backend dispatch) and
        two surviving only degraded, including core placement, which becomes a request the OS need
        not honour and will not confirm. Measured on two iPhones: the runtime picks one thread, and
        a second costs 16.8% and 11.4%.
        <a href={withBase("/evidence/#portability")}>What survived, and what did not</a>.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-[1200px] px-4 md:px-6 py-8">
    <p class="eyebrow" data-reveal>How it works</p>
    <h2 class="mt-2 text-xl md:text-2xl font-bold" data-reveal>Three moves, per phone</h2>
    <ol class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-4" data-stagger="90">
      {
        steps.map((c, i) => (
          <li class="card lift p-6 min-w-0" data-reveal>
            <span class="ghost-index !text-[2.5rem] block text-accent-line" style="-webkit-text-stroke:1px var(--accent-line)">
              {String(i + 1).padStart(2, "0")}
            </span>
            <h3 class="mt-3 text-[0.875rem] font-bold tracking-[0.04em] uppercase">{c.t}</h3>
            <p class="mt-2 text-[0.8125rem] text-dim leading-relaxed">{c.d}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="mx-auto max-w-[1200px] px-4 md:px-6 py-8 grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="card p-6 md:p-8 min-w-0" data-reveal>
      <p class="eyebrow">Why watts</p>
      <h2 class="mt-2 text-lg md:text-xl font-bold">Built for where the network is not</h2>
      <p class="mt-3 text-[0.875rem] text-dim leading-relaxed">
        Dead zones, grid-down, rural gaps - where a cloud assistant stops working and battery is
        survival. So the headline axis is tokens per watt, measured per pass from battery current
        and voltage, and hidden whenever charging would fake it.
      </p>
      <p class="mt-3 text-[0.875rem] text-fg leading-relaxed">
        The same 128 tokens cost 86 J naive and 50 J optimized - by finishing in 11.8 s instead
        of 19.9 s.
      </p>
    </div>
    <div class="card p-6 md:p-8 min-w-0 flex flex-col" data-reveal>
      <div class="flex items-center justify-between gap-3">
        <p class="eyebrow">Live board</p>
        <span class="text-[0.6875rem] text-dim">{groups.length} devices &middot; {socCount} SoCs</span>
      </div>
      <h2 class="mt-2 text-lg md:text-xl font-bold">How much tuning earns, per chip</h2>
      <ol class="mt-4 space-y-2">
        {
          top3.map((g, i) => (
            <li class="flex items-center gap-3 text-[0.8125rem] border-b border-outline pb-2 last:border-0">
              <span class="text-accent-ink font-bold w-5">{i + 1}</span>
              <span class="min-w-0 flex-1 truncate">
                {g.primary.device}
                <span class="text-dim"> &middot; {g.primary.soc.name}</span>
              </span>
              {g.primary.provisional && (
                <span class="chip !text-[0.6875rem]" title="single pass - provisional">1 run</span>
              )}
              <span class="font-bold text-[0.9375rem]">{fmtX(g.primary.multiplier)}</span>
            </li>
          ))
        }
      </ol>
      <p class="mt-4 text-[0.75rem] text-dim leading-relaxed">
        {socCount} distinct Arm SoCs, and I own two of them. Everything from a Cortex-A53 Helio
        G37 to a Tensor G5 arrived because somebody else ran the benchmark and switched sharing
        on - which is the only way a claim about Arm phones in general could be tested at all.
      </p>
      <div class="mt-auto pt-4 flex flex-wrap gap-2">
        <a href={withBase("/leaderboard/")} class="btn">Open the leaderboard</a>
        <a href={withBase("/predict/")} class="btn">Predict your phone</a>
      </div>
    </div>
  </section>

  <div class="mt-6">
    <Marquee items={marqueeWords} dur="50s" />
  </div>

  <section class="mx-auto max-w-[1200px] px-4 md:px-6 py-14">
    <div
      class="card p-6 md:p-10 text-center flex flex-col items-center"
      data-reveal
      style="background:linear-gradient(180deg,var(--accent-wash),transparent)"
    >
      <p class="eyebrow">Two apps, one runtime</p>
      <h2 class="mt-3 text-xl md:text-2xl font-bold max-w-[22ch]">
        Install ENTITY, or reproduce every number with ENTITY Bench
      </h2>
      <p class="mt-3 max-w-[52ch] text-[0.875rem] text-dim">
        Direct APKs with SHA-256. arm64-v8a, Android 13+, Apache-2.0. No account, no telemetry
        you did not switch on.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a href={withBase("/apps/#download")} class="btn btn-solid">Download the APKs</a>
        <a href={withBase("/predict/")} class="btn">See what your phone would do first</a>
        <a href={withBase("/evidence/")} class="btn">Read the evidence</a>
      </div>
      <p class="mt-6 text-[0.75rem] text-dim max-w-[60ch]">
        This project's own ablation disproved its own v2.0.0 headline and published the
        correction instead of burying it -
        <a href={withBase("/journey/")}>the withdrawn claims</a> are why the surviving numbers can
        be trusted.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-[1200px] px-4 md:px-6 pb-16" aria-label="About the builder">
    <div
      class="card p-6 md:p-8 grid gap-6 md:gap-8 md:grid-cols-[auto_1fr] md:items-center"
      data-reveal
    >
      <span
        class="grid place-items-center w-16 h-16 md:w-20 md:h-20 rounded-2xl border border-accent-line bg-accent-wash text-accent-ink text-2xl md:text-3xl font-bold shrink-0"
        aria-hidden="true"
      >
        KV
      </span>
      <div class="min-w-0">
        <p class="eyebrow">Who built this</p>
        <h2 class="mt-2 text-xl md:text-2xl font-bold">Kamalesh VS</h2>
        <p class="mt-3 max-w-[64ch] text-dim text-[0.9375rem] leading-relaxed">
          A solo build for the Arm Create: AI Optimization Challenge 2026. I build things that
          sense, move and fly - embedded systems, computer vision and on-device AI. ENTITY is that
          same instinct pointed at the CPU already in your pocket: measure it, tune to it, and
          prove every number.
        </p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a href="https://kkjj.me" class="btn btn-solid">kkjj.me</a>
          <a href="https://github.com/kkjjkamal123" class="btn">GitHub</a>
          <a href="https://kkjj.me/#contact" class="btn">Get in touch</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

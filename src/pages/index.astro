---
import Layout from "../components/Layout.astro";
import MetricsStrip from "../components/MetricsStrip.astro";
import A1Race from "../components/figures/A1Race.astro";
import A2Straggler from "../components/figures/A2Straggler.astro";
import { withBase } from "../lib/url";
import snapshot from "../data/leaderboard.json";
import { processRows, sortGroups, fmtX, type BenchRow } from "../lib/bench";

const groups = processRows(snapshot.rows as unknown as BenchRow[]);
const top3 = sortGroups(
  groups.filter((g) => !g.primary.highVariance),
  "multiplier"
).slice(0, 3);

const stats = [
  {
    n: "+68%",
    what: "decode vs naive",
    cond: "10.8 to 18.1 tok/s, CMF Phone 1, 5 runs per arm, 2026-07-18",
  },
  {
    n: "42%",
    what: "less battery, same 128 tokens",
    cond: "86 J naive vs 50 J optimized, unplugged, integrated from 150 ms samples",
  },
  {
    n: "3.4x",
    what: "lower time to first token",
    cond: "13,440 ms in v2.0.0 to 3,918 ms in v2.1.0, same phone and model",
  },
  {
    n: "0",
    what: "network calls in the inference path",
    cond: "the opt-in model catalog download is the only feature that touches the network",
  },
];

const decisions = [
  {
    t: "CPU backend",
    d: "Ships seven Arm CPU backend variants, armv8.0 through armv9.2. ggml scores them against the silicon at startup and loads the best one the phone supports.",
  },
  {
    t: "KleidiAI advisor",
    d: "Arm's KleidiAI has kernels for Q4_0 and Q8_0 only. ENTITY reads the GGUF header and says whether the loaded model can reach Arm's kernels, and what it costs when it cannot.",
  },
  {
    t: "Fast-core selection",
    d: "Ranks cores by live max frequency, derives the decode width from the top cluster (2 to 6), and pins decode to the performance cores. Prefill derives a separate, usually wider set from kernel cpu_capacity.",
  },
  {
    t: "Adaptive context",
    d: "Selects a 2048 to 8192 token window from model size and free RAM, so a 3B-class model fits instead of failing.",
  },
  {
    t: "Thermal policy",
    d: "Checks Android thermal status during generation and adds a small cooperative delay when heat rises. Efficiency mode doubles the delay and caps inference at two threads.",
  },
  {
    t: "Energy telemetry",
    d: "Reports tokens, token rate, TTFT, temperature, watts, tokens per watt and free memory, live, while it generates.",
  },
  {
    t: "Three-arm ablation",
    d: "The benchmark does not just report a number, it attributes it: naive, threads-only, and Auto, so a reader sees which decision earned the speedup and which did not.",
  },
];
---

<Layout
  title="ENTITY - adaptive on-device LLM runtime for Arm phones"
  description="Fully offline Android chat that tunes llama.cpp to the Arm CPU in the phone, and proves which optimization earned the speedup: measured decode, energy per token, and a public device leaderboard."
  path="/"
>
  <section class="mx-auto max-w-[1200px] px-4 md:px-6 pt-14 md:pt-20 pb-10">
    <p class="microlabel">Fully offline &middot; arm64-v8a &middot; Android 13+ &middot; Apache-2.0</p>
    <h1 class="mt-4 text-[1.75rem] md:text-[2.6rem] leading-[1.15] font-bold max-w-[24ch]">
      Your phone's AI is waiting on its slowest cores.
    </h1>
    <p class="mt-5 max-w-[62ch] text-dim text-[0.9375rem] md:text-base">
      ENTITY reads the silicon, derives the thread width, pins the cluster - then ships the
      three-arm ablation that proves which decision earned the speedup, and what it cost in watts.
    </p>
    <div class="mt-7 flex flex-wrap gap-3">
      <a href={withBase("/apps/#download")} class="btn btn-solid">Download ENTITY</a>
      <a href={withBase("/evidence/")} class="btn">See the evidence</a>
    </div>

    <div class="mt-12">
      <A1Race />
    </div>
  </section>

  <MetricsStrip />

  <section class="mx-auto max-w-[1200px] px-4 md:px-6 py-12" aria-label="Headline numbers">
    <dl class="grid grid-cols-2 lg:grid-cols-4 gap-px bg-outline border border-outline rounded-[10px] overflow-hidden">
      {
        stats.map((s) => (
          <div class="bg-surface p-5 flex flex-col">
            <dd class="order-1 text-[1.75rem] font-bold leading-none">{s.n}</dd>
            <dt class="order-2 text-[0.8125rem] mt-1">{s.what}</dt>
            <dd class="order-3 mt-3 text-[0.6875rem] text-dim leading-relaxed">{s.cond}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="mx-auto max-w-[1200px] px-4 md:px-6 py-10">
    <h2 class="text-xl md:text-2xl font-bold">What ENTITY decides at runtime</h2>
    <p class="mt-2 text-dim max-w-[68ch] text-[0.875rem]">
      Not a wrapper with a theme. An inference-optimization layer over llama.cpp, with a Kotlin UI
      and a C++ JNI path, making hardware-aware decisions per phone.
    </p>
    <div class="mt-6 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {
        decisions.map((c) => (
          <div class="card p-5">
            <h3 class="text-[0.8125rem] font-bold tracking-[0.08em] uppercase">{c.t}</h3>
            <p class="mt-2 text-[0.8125rem] text-dim leading-relaxed">{c.d}</p>
          </div>
        ))
      }
      <a
        href={withBase("/optimizations/")}
        class="card p-5 no-underline flex items-center justify-between gap-2 hover:border-dim transition-colors duration-150"
      >
        <span class="text-[0.8125rem] font-bold tracking-[0.08em] uppercase"
          >Every lever, with sources</span
        >
        <span aria-hidden="true" class="text-dim">&rarr;</span>
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-[1200px] px-4 md:px-6 py-10">
    <h2 class="text-xl md:text-2xl font-bold">The mechanism, not just the number</h2>
    <p class="mt-2 mb-6 text-dim max-w-[68ch] text-[0.875rem]">
      The gain that generalises across every SoC measured is the thread count. This is why.
    </p>
    <A2Straggler />
  </section>

  <MetricsStrip />

  <section class="mx-auto max-w-[1200px] px-4 md:px-6 py-12 grid grid-cols-1 lg:grid-cols-2 gap-8">
    <div class="card p-6 min-w-0">
      <p class="microlabel">Why offline, why watts</p>
      <h2 class="mt-2 text-lg font-bold">Built for where the network is not</h2>
      <p class="mt-3 text-[0.875rem] text-dim leading-relaxed">
        Dead roaming zones. Disaster and grid-down scenarios. Rural gaps. An assistant is most
        needed exactly where a cloud one stops working - and there, battery is survival. That is
        why ENTITY's headline axis is tokens per watt, measured per pass from battery current and
        voltage, and hidden whenever charging would fake it.
      </p>
      <p class="mt-3 text-[0.875rem] text-dim leading-relaxed">
        The same 128 tokens cost 86 J naive and 50 J optimized on the reference phone - not from
        drawing fewer watts, but from finishing in 11.8 s instead of 19.9 s.
      </p>
    </div>
    <div class="card p-6 min-w-0">
      <p class="microlabel">Live board</p>
      <h2 class="mt-2 text-lg font-bold">How much tuning earns, per chip</h2>
      <ol class="mt-4 space-y-2">
        {
          top3.map((g, i) => (
            <li class="flex items-center gap-3 text-[0.8125rem]">
              <span class="text-dim w-4">{i + 1}</span>
              <span class="min-w-0 flex-1 truncate">
                {g.primary.device}
                <span class="text-dim"> &middot; {g.primary.soc.name}</span>
              </span>
              {g.primary.provisional && (
                <span class="chip !text-[0.625rem]" title="single pass - provisional">
                  1 run
                </span>
              )}
              <span class="font-bold">{fmtX(g.primary.multiplier)}</span>
            </li>
          ))
        }
      </ol>
      <p class="mt-3 text-[0.6875rem] text-dim">
        Tuning multiplier: optimized decode over the naive 8-thread default, one row per device
        and quantization. Single-pass rows are provisional.
      </p>
      <a href={withBase("/leaderboard/")} class="btn mt-4">Open the leaderboard</a>
    </div>
  </section>

  <section class="mx-auto max-w-[1200px] px-4 md:px-6 py-10">
    <div class="card p-6 md:p-8 border-dashed">
      <p class="microlabel">Why trust any of this</p>
      <p class="mt-3 text-[0.9375rem] md:text-base max-w-[68ch] leading-relaxed">
        This project's own ablation disproved its own headline claim - the v2.0.0 "+121% from
        big-core affinity" - and published the correction instead of burying it. The falsifications
        are the evidence that the surviving numbers were actually checked.
      </p>
      <a href={withBase("/journey/")} class="btn mt-5">Read the withdrawn claims</a>
    </div>
  </section>
</Layout>

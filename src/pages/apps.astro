---
import Layout from "../components/Layout.astro";
import PhoneFrame from "../components/PhoneFrame.astro";
import Shot from "../components/Shot.astro";
import Carousel from "../components/Carousel.astro";
import { withBase } from "../lib/url";

const REPO = "https://github.com/kkjjkamal123/ENTITY---Arm-Create-AI-Optimization-Challenge";
const DL = `${REPO}/releases/latest/download`;
const BENCH_APK_DL = `https://github.com/kkjjkamal123/ENTITY---Arm-Create-AI-Optimization-Challenge/releases/download/EB_V2.2.0/ENTITY-Bench-v2.2.0-release.apk`;

const chatShots: { slug: any; title: string; cap: string }[] = [
  { slug: "chat-home", title: "Live metrics while it generates", cap: "100 tok - 16.4 t/s - TTFT 299 ms - 33.0C - 4.34 W - CPU 47% - 1.2 GB, plus the selectable colour graph, the one colour surface in the app." },
  { slug: "chat-menu", title: "One drawer, everything", cap: "v3.6.2, conversation history, model selector, BENCHMARK / SHARE CHAT / BENCHMARK HISTORY, SETTINGS and ABOUT." },
  { slug: "chat-models", title: "A catalog sized to your phone", cap: "On-device files plus a catalog ranked for this SoC, with KLEIDIAI / NO KLEIDIAI and GOOD FIT / FITS chips per row." },
  { slug: "chat-model-info", title: "The full model readout", cap: "KLEIDIAI ACTIVE - Q4_0, 773 MB, trained context 131,072, running context 4096 auto-fit to free RAM. Compute: CPU, 4 perf cores, dotprod, KleidiAI active." },
  { slug: "chat-benchmark", title: "Benchmark from inside chat", cap: "Runs per config, sustained thermal test, PP 512 / TG 128, and a cooldown before every pass." },
  { slug: "chat-about", title: "The runtime, in its own words", cap: "BIG-CORE AFFINITY, RUNTIME-SELECTED CPU BACKEND, ADAPTIVE CONTEXT, AUTO MODE, THERMAL-AWARE GUARD, KV SESSION CACHE." },
  { slug: "chat-settings-1", title: "Yours to theme", cap: "Theme (System / Light / Dark), Monochrome / Colour palette, text size, and which live-metric series the graph draws." },
  { slug: "chat-settings-2", title: "Auto, or exactly your way", cap: "Auto (optimized) plus manual sliders, Efficiency mode, and CORE PLACEMENT: AUTO / PERF CORES / SCHEDULER - pinning is a setting, not an assumption." },
  { slug: "chat-benchmark-history", title: "Every run, kept on-device", cap: "Benchmark history saved locally: +85% decode vs naive, 1 run, 3-arm, unplugged." },
];

const benchShots: { slug: any; title: string; cap: string }[] = [
  { slug: "bench-device", title: "Know the device under test", cap: "Nothing A015, 4x 2.5GHz + 4x 2.0GHz, UNPLUGGED OK - with the optimization grid: solid = live on this device, outline = not present." },
  { slug: "bench-config-result", title: "Configure, then attribute", cap: "3-ARM / SUSTAINED / SWEEP, runs per arm, DECODE +102% VS NAIVE - one run, single-pass and provisional under the leaderboard's own rules. Footer: v2.1.1, arm64, no network, results stay on this phone." },
  { slug: "bench-settings", title: "Control the run", cap: "Theme, palette, keep screen on during a run, the optional efficiency-core arm, plus model and result management." },
  { slug: "bench-contribute", title: "Contribute, on your terms", cap: "Off by default, summary numbers only, no accounts, no identifier linking two runs - with SHOW EXACTLY WHAT GETS SENT before the first upload." },
  { slug: "bench-full-result", title: "The whole result, per arm", cap: "Prompt 111/127/140, decode 9.0/14.6/18.1, TTFT 4724/4100/3712 ms, power 4.3/4.6/4.2 W, tok/W 2.1/3.2/4.3, with clocks, free RAM and thermal state." },
];
---

<Layout
  title="Apps - ENTITY chat and ENTITY Bench"
  description="Two apps: the fully offline ENTITY assistant (v3.7.0) and the standalone ENTITY Bench ablation tool (v2.2.0). Direct APK downloads with SHA-256, arm64-v8a, Android 13+."
  path="/apps/"
>
  <section class="mx-auto max-w-[1200px] px-4 md:px-6 pt-12 pb-8">
    <p class="microlabel">arm64-v8a &middot; Android 13+ &middot; Apache-2.0</p>
    <h1 class="mt-3 text-2xl md:text-3xl font-bold">Two apps, one runtime</h1>
    <p class="mt-3 max-w-[68ch] text-dim text-[0.875rem]">
      ENTITY is the assistant. ENTITY Bench is the same three-arm ablation as a standalone tool,
      so any arm64 phone can reproduce or challenge the findings - and contribute a row to the
      public dataset.
    </p>
  </section>

  <section id="download" class="mx-auto max-w-[1200px] px-4 md:px-6 pb-10 grid grid-cols-1 md:grid-cols-2 gap-4 scroll-mt-20">
    <div class="card p-6 min-w-0">
      <div class="flex items-center gap-3">
        <span class="grid place-items-center w-11 h-11 rounded-[10px] border border-outline bg-surface shrink-0">
          <img src={withBase("/img/icon-dark.png")} alt="ENTITY icon" width="36" height="36" class="only-dark" />
          <img src={withBase("/img/icon-light.png")} alt="ENTITY icon" width="36" height="36" class="only-light" />
        </span>
        <div>
          <h2 class="text-lg font-bold leading-tight">ENTITY <span class="text-dim font-normal text-[0.8125rem]">v3.7.0</span></h2>
          <p class="text-[0.6875rem] text-dim">on-device LLM chat</p>
        </div>
      </div>
      <a class="btn btn-solid mt-4 w-full" href={`${DL}/ENTITY-v25-device-probe-20260808-release.apk`}>Download APK &middot; 10.0 MB</a>
      <dl class="mt-3 text-[0.6875rem] text-dim space-y-1">
        <div class="flex gap-2"><dt class="shrink-0">file</dt><dd class="truncate min-w-0">ENTITY-v25-device-probe-20260808-release.apk</dd></div>
        <div class="flex gap-2"><dt class="shrink-0">sha-256</dt><dd class="break-all min-w-0">5738b6d2af34f0b25e838aca679d306e98b51eadcb1875d707b8fcf8861004bf</dd></div>
        <div class="flex gap-2"><dt class="shrink-0">requires</dt><dd>arm64-v8a, Android 13+</dd></div>
      </dl>
      <p class="mt-3 text-[0.6875rem] text-dim leading-relaxed">
        <span class="font-bold">Upgrading from v3.6.2 or earlier?</span> v3.7.0 is signed with a new
        certificate, so an in-place update fails with
        <code>INSTALL_FAILED_UPDATE_INCOMPATIBLE</code> and you have to uninstall first - which
        deletes saved conversations. Export anything you want with SHARE CHAT before you do. A fresh
        install is unaffected. A certificate mismatch normally means a tampered build, so this is
        stated here rather than left to surprise you; the reason is
        <a href={withBase("/journey/")}>entry 11 on the journey page</a>.
      </p>
    </div>
    <div class="card p-6 min-w-0">
      <div class="flex items-center gap-3">
        <span class="grid place-items-center w-11 h-11 rounded-[10px] border border-outline bg-surface shrink-0">
          <img src={withBase("/img/bench-icon-dark.png")} alt="ENTITY Bench icon" width="36" height="36" class="only-dark" />
          <img src={withBase("/img/bench-icon-light.png")} alt="ENTITY Bench icon" width="36" height="36" class="only-light" />
        </span>
        <div>
          <h2 class="text-lg font-bold leading-tight">ENTITY Bench <span class="text-dim font-normal text-[0.8125rem]">v2.2.0</span></h2>
          <p class="text-[0.6875rem] text-dim">on-device LLM benchmark</p>
        </div>
      </div>
      <a class="btn btn-solid mt-4 w-full" href={BENCH_APK_DL}>Download APK &middot; 9.9 MB</a>
      <dl class="mt-3 text-[0.6875rem] text-dim space-y-1">
        <div class="flex gap-2"><dt class="shrink-0">file</dt><dd class="truncate min-w-0">ENTITY-Bench-v2.2.0-release.apk</dd></div>
        <div class="flex gap-2"><dt class="shrink-0">sha-256</dt><dd class="break-all min-w-0">6ca560c1cbe1b713d55e5d9e6837137f590d62d3190dced8bc496adbbe7c18f0</dd></div>
        <div class="flex gap-2"><dt class="shrink-0">requires</dt><dd>arm64-v8a, Android 13+</dd></div>
      </dl>
      <p class="mt-3 text-[0.6875rem] text-dim leading-relaxed">
        <span class="font-bold">Same certificate change as the assistant.</span> Upgrading over
        v2.1.1 fails and needs an uninstall first, which deletes saved benchmark history - export
        each result you want to keep to CSV beforehand. A fresh install is unaffected.
      </p>
    </div>
    <div class="md:col-span-2 card p-6">
      <p class="microlabel">Ninety seconds from clone to chatting</p>
      <pre class="scroll-x mt-3 rounded-[6px] border border-outline bg-bg p-4 text-[0.75rem] leading-relaxed"><code>git clone https://github.com/kkjjkamal123/ENTITY---Arm-Create-AI-Optimization-Challenge.git
cd ENTITY---Arm-Create-AI-Optimization-Challenge
adb install -r apk/ENTITY-v25-device-probe-20260808-release.apk</code></pre>
      <p class="mt-3 text-[0.8125rem] text-dim max-w-[68ch]">
        Then on the phone: pick a model from the in-app catalog or import a GGUF you already
        have. <span class="text-fg">Prefer Q4_0 or Q8_0</span> - the only two types that reach
        Arm's KleidiAI kernels (<a href={withBase("/optimizations/#a4")}>why</a>); the
        recommended starting point is
        <code>Llama-3.2-1B-Instruct-Q4_0.gguf</code>. Leave Auto on, then open BENCHMARK and run
        the ablation unplugged to see power and tokens per watt.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-[1200px] px-4 md:px-6 py-8">
    <h2 class="text-xl md:text-2xl font-bold">ENTITY - the assistant</h2>
    <ul class="mt-4 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-2 text-[0.8125rem] text-dim max-w-[64rem]">
      <li>Fully offline chat for runnable GGUF models (Llama 3.2 1B / 3B and others).</li>
      <li>Streaming replies with Stop, Markdown and LaTeX rendering, copy and regenerate.</li>
      <li>Persistent local conversations - restore, rename, switch, delete.</li>
      <li>Auto mode plus manual temperature, top-k, top-p, length, context and threads.</li>
      <li>Live stats bar and seven-series graph: tokens, rate, TTFT, temperature, watts, CPU, memory.</li>
      <li>In-app three-arm benchmark with history, CSV export and core-placement verdict.</li>
      <li>A recommended model for this phone, from a 60 ms probe that needs no model downloaded.</li>
      <li>Model cards report the KleidiAI coverage measured from the file's own tensor table.</li>
      <li>Long-press any reply for its token accounting: prompt read, tokens written, both rates.</li>
    </ul>
    <div class="mt-5 grid grid-cols-1 md:grid-cols-3 gap-4 max-w-[64rem]">
      <div class="card p-5">
        <h3 class="text-[0.9375rem] font-bold">Before you download</h3>
        <p class="mt-2 text-[0.8125rem] text-dim leading-relaxed">
          The catalog spans seven vendors and 0.36B to 7B. Each entry is judged against memory the
          phone reports free right now - not installed RAM, which counts capacity already spent on
          everything else open - and, once the probe has run, carries an estimated generation rate
          and time to first token. The reasoning is on the
          <a href={withBase("/optimizations/")}>optimizations page</a>.
        </p>
      </div>
      <div class="card p-5">
        <h3 class="text-[0.9375rem] font-bold">What the file actually contains</h3>
        <p class="mt-2 text-[0.8125rem] text-dim leading-relaxed">
          A GGUF named Q4_0 is not uniformly Q4_0. ENTITY parses the tensor table and reports the
          fraction of weights that reach Arm's kernels, naming the largest tensor that does not -
          on the reference Llama-3.2-1B-Q4_0 that is 76%, and the missing quarter includes the
          output projection.
        </p>
      </div>
      <div class="card p-5">
        <h3 class="text-[0.9375rem] font-bold">What that answer cost</h3>
        <p class="mt-2 text-[0.8125rem] text-dim leading-relaxed">
          Prompt and generated tokens are reported apart, never as one rate. They are produced by
          different regimes - the prompt goes through in batches and is compute-bound, each
          generated token re-reads every weight and is bandwidth-bound. Averaging them is why speed
          claims about local models are so often incomparable. Timings cover model execution only,
          so a slow redraw cannot pass as a slow model.
        </p>
      </div>
    </div>
    <div class="mt-6 card p-4 md:p-8" data-reveal>
      <Carousel id="chat-shots" label="ENTITY chat screenshots">
        {
          chatShots.map((s, i) => (
            <figure class="carousel__slide">
              <div class="showcase">
                <PhoneFrame class="w-full max-w-[22rem]">
                  <Shot slug={s.slug} alt={s.title} eager={i === 0} />
                </PhoneFrame>
                <figcaption>
                  <p class="eyebrow">{`ENTITY chat - ${i + 1} / ${chatShots.length}`}</p>
                  <h3 class="mt-3 text-xl md:text-3xl font-bold leading-tight">{s.title}</h3>
                  <p class="mt-4 text-[0.9375rem] md:text-lg text-dim leading-relaxed">{s.cap}</p>
                </figcaption>
              </div>
            </figure>
          ))
        }
      </Carousel>
    </div>
  </section>

  <section class="mx-auto max-w-[1200px] px-4 md:px-6 py-8">
    <h2 class="text-xl md:text-2xl font-bold">ENTITY Bench - the experiment, standalone</h2>
    <p class="mt-2 text-dim text-[0.875rem] max-w-[68ch]">
      No chat. Import a model, run the ablation, get an attributed result: naive, threads-only,
      auto - plus the optional efficiency-core arm, SUSTAINED mode (who throttles first once the
      SoC is hot) and SWEEP mode (every thread width, pinned and scheduler-placed).
    </p>
    <div class="mt-6 card p-4 md:p-8" data-reveal>
      <Carousel id="bench-shots" label="ENTITY Bench screenshots">
        {
          benchShots.map((s, i) => (
            <figure class="carousel__slide">
              <div class="showcase">
                <PhoneFrame class="w-full max-w-[22rem]">
                  <Shot slug={s.slug} alt={s.title} eager={i === 0} />
                </PhoneFrame>
                <figcaption>
                  <p class="eyebrow">{`ENTITY Bench - ${i + 1} / ${benchShots.length}`}</p>
                  <h3 class="mt-3 text-xl md:text-3xl font-bold leading-tight">{s.title}</h3>
                  <p class="mt-4 text-[0.9375rem] md:text-lg text-dim leading-relaxed">{s.cap}</p>
                </figcaption>
              </div>
            </figure>
          ))
        }
      </Carousel>
    </div>
    <p class="mt-6 text-[0.8125rem] text-dim">
      Sources and build instructions: <a href={REPO}>the repository</a> &middot; contribute a
      row: <a href={withBase("/leaderboard/")}>the leaderboard</a>.
    </p>
  </section>
</Layout>

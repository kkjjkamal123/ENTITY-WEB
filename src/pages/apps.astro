---
import Layout from "../components/Layout.astro";
import PhoneFrame from "../components/PhoneFrame.astro";
import Shot from "../components/Shot.astro";
import IsaChipGrid from "../components/IsaChipGrid.astro";
import { withBase } from "../lib/url";

const REPO = "https://github.com/kkjjkamal123/ENTITY---Arm-Create-AI-Optimization-Challenge";
const DL = "https://github.com/kkjjkamal123/ENTITY/releases/latest/download";

const chatShots: { slug: any; cap: string }[] = [
  { slug: "chat-home", cap: "Live metrics while generating: 100tok - 16.4t/s - TTFT 299ms - 33.0C - 4.34W - CPU 47% - 1.2GB, plus the selectable colour graph - the one colour surface in the app." },
  { slug: "chat-menu", cap: "The drawer: v3.6.2, conversation history, model selector, BENCHMARK / SHARE CHAT / BENCHMARK HISTORY, SETTINGS, ABOUT." },
  { slug: "chat-models", cap: "Models: on-device files plus a catalog sized and ranked for this phone, with KLEIDIAI / NO KLEIDIAI and GOOD FIT / FITS chips per row." },
  { slug: "chat-model-info", cap: "Model info: KLEIDIAI ACTIVE - Q4_0, 773 MB, trained context 131,072, running context 4096 (auto-fit to free RAM), Compute: CPU - 4 perf cores - dotprod - KleidiAI active." },
  { slug: "chat-benchmark", cap: "The in-chat benchmark: runs per config, sustained thermal test, PP 512 / TG 128, cooldown before every pass." },
  { slug: "chat-about", cap: "About, in the app's own words: BIG-CORE AFFINITY, RUNTIME-SELECTED CPU BACKEND, ADAPTIVE CONTEXT, AUTO MODE, THERMAL-AWARE GUARD, KV SESSION CACHE." },
  { slug: "chat-settings-1", cap: "Theme (System / Light / Dark), Monochrome / Colour palette, text size, live metrics and graph series." },
  { slug: "chat-settings-2", cap: "Auto (optimized) plus manual sliders, Efficiency mode, and CORE PLACEMENT: AUTO / PERF CORES / SCHEDULER - pinning is a setting, not an assumption." },
  { slug: "chat-benchmark-history", cap: "Benchmark history, saved on-device: +85% decode vs naive, 1 run, 3-arm, unplugged." },
];

const benchShots: { slug: any; cap: string }[] = [
  { slug: "bench-device", cap: "Device under test: Nothing A015, 4x 2.5GHz + 4x 2.0GHz, UNPLUGGED OK - and the optimization grid: solid = live on this device, outline = not present." },
  { slug: "bench-config-result", cap: "Config and last result: 3-ARM / SUSTAINED / SWEEP, runs per arm, DECODE +102% VS NAIVE - what the bench screen reported on one run (single-pass, provisional under the leaderboard's own rules) - and the footer: v2.1.1 - arm64 - no network - results stay on this phone." },
  { slug: "bench-settings", cap: "Settings: theme, palette, keep screen on during a run, the optional efficiency-core arm, model and result management." },
  { slug: "bench-contribute", cap: "Contribute results: off by default, summary numbers only, no accounts, no identifier linking two runs - plus SHOW EXACTLY WHAT GETS SENT." },
  { slug: "bench-full-result", cap: "A full result: prompt 111/127/140, decode 9.0/14.6/18.1, TTFT 4724/4100/3712 ms, power 4.3/4.6/4.2 W, tok/W 2.1/3.2/4.3, with clocks, free RAM and thermal state per arm." },
];
---

<Layout
  title="Apps - ENTITY chat and ENTITY Bench"
  description="Two apps: the fully offline ENTITY assistant (v3.6.2) and the standalone ENTITY Bench ablation tool (v2.1.1). Direct APK downloads with SHA-256, arm64-v8a, Android 13+."
  path="/apps/"
>
  <section class="mx-auto max-w-[1200px] px-4 md:px-6 pt-12 pb-8">
    <p class="microlabel">arm64-v8a &middot; Android 13+ &middot; Apache-2.0</p>
    <h1 class="mt-3 text-2xl md:text-3xl font-bold">Two apps, one runtime</h1>
    <p class="mt-3 max-w-[68ch] text-dim text-[0.875rem]">
      ENTITY is the assistant. ENTITY Bench is the same three-arm ablation as a standalone tool,
      so any arm64 phone can reproduce or challenge the findings - and contribute a row to the
      public dataset.
    </p>
  </section>

  <section id="download" class="mx-auto max-w-[1200px] px-4 md:px-6 pb-10 grid grid-cols-1 md:grid-cols-2 gap-4 scroll-mt-20">
    <div class="card p-6 min-w-0">
      <div class="flex items-center gap-3">
        <img src={withBase("/img/icon-dark.png")} alt="" width="40" height="40" class="rounded-[9px] border border-outline" />
        <div>
          <h2 class="text-lg font-bold leading-tight">ENTITY <span class="text-dim font-normal text-[0.8125rem]">v3.6.2</span></h2>
          <p class="text-[0.6875rem] text-dim">on-device LLM chat</p>
        </div>
      </div>
      <a class="btn btn-solid mt-4 w-full" href={`${DL}/ENTITY-v24-entity-identity-prompt-20260724-release.apk`}>Download APK &middot; 10.4 MB</a>
      <dl class="mt-3 text-[0.6875rem] text-dim space-y-1">
        <div class="flex gap-2"><dt class="shrink-0">file</dt><dd class="truncate min-w-0">ENTITY-v24-entity-identity-prompt-20260724-release.apk</dd></div>
        <div class="flex gap-2"><dt class="shrink-0">sha-256</dt><dd class="break-all min-w-0">5f638f3f7ec4eec376d1a2db03ca1bff64706d23b757792afa0bcb6d384fede6</dd></div>
        <div class="flex gap-2"><dt class="shrink-0">requires</dt><dd>arm64-v8a, Android 13+</dd></div>
      </dl>
    </div>
    <div class="card p-6 min-w-0">
      <div class="flex items-center gap-3">
        <img src={withBase("/img/bench-icon-dark.png")} alt="" width="40" height="40" class="rounded-[9px] border border-outline" />
        <div>
          <h2 class="text-lg font-bold leading-tight">ENTITY Bench <span class="text-dim font-normal text-[0.8125rem]">v2.1.1</span></h2>
          <p class="text-[0.6875rem] text-dim">on-device LLM benchmark</p>
        </div>
      </div>
      <a class="btn btn-solid mt-4 w-full" href={`${DL}/ENTITY-Bench-v2.1.1-release.apk`}>Download APK &middot; 10.3 MB</a>
      <dl class="mt-3 text-[0.6875rem] text-dim space-y-1">
        <div class="flex gap-2"><dt class="shrink-0">file</dt><dd class="truncate min-w-0">ENTITY-Bench-v2.1.1-release.apk</dd></div>
        <div class="flex gap-2"><dt class="shrink-0">sha-256</dt><dd class="break-all min-w-0">305f71f6d1b93ba20f5e3503827c0d5e1d557f2dfd0be104c5f0b9549cf34f23</dd></div>
        <div class="flex gap-2"><dt class="shrink-0">requires</dt><dd>arm64-v8a, Android 13+</dd></div>
      </dl>
    </div>
    <div class="md:col-span-2 card p-6">
      <p class="microlabel">Ninety seconds from clone to chatting</p>
      <pre class="scroll-x mt-3 rounded-[6px] border border-outline bg-bg p-4 text-[0.75rem] leading-relaxed"><code>git clone https://github.com/kkjjkamal123/ENTITY---Arm-Create-AI-Optimization-Challenge.git
cd ENTITY---Arm-Create-AI-Optimization-Challenge
adb install -r apk/ENTITY-v24-entity-identity-prompt-20260724-release.apk</code></pre>
      <p class="mt-3 text-[0.8125rem] text-dim max-w-[68ch]">
        Then on the phone: pick a model from the in-app catalog or import a GGUF you already
        have. <span class="text-fg">Prefer Q4_0 or Q8_0</span> - the only two types that reach
        Arm's KleidiAI kernels (<a href={withBase("/optimizations/#a4")}>why</a>); the
        recommended starting point is
        <code>Llama-3.2-1B-Instruct-Q4_0.gguf</code>. Leave Auto on, then open BENCHMARK and run
        the ablation unplugged to see power and tokens per watt.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-[1200px] px-4 md:px-6 py-8">
    <h2 class="text-xl md:text-2xl font-bold">ENTITY - the assistant</h2>
    <ul class="mt-4 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-2 text-[0.8125rem] text-dim max-w-[64rem]">
      <li>Fully offline chat for runnable GGUF models (Llama 3.2 1B / 3B and others).</li>
      <li>Streaming replies with Stop, Markdown and LaTeX rendering, copy and regenerate.</li>
      <li>Persistent local conversations - restore, rename, switch, delete.</li>
      <li>Auto mode plus manual temperature, top-k, top-p, length, context and threads.</li>
      <li>Live stats bar and seven-series graph: tokens, rate, TTFT, temperature, watts, CPU, memory.</li>
      <li>In-app three-arm benchmark with history, CSV export and core-placement verdict.</li>
    </ul>
    <div class="mt-6 grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4">
      {
        chatShots.map((s) => (
          <figure class="min-w-0">
            <PhoneFrame>
              <Shot slug={s.slug} alt={s.cap} />
            </PhoneFrame>
            <figcaption class="mt-2 text-[0.6875rem] leading-relaxed">{s.cap}</figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-[1200px] px-4 md:px-6 py-8">
    <h2 class="text-xl md:text-2xl font-bold">ENTITY Bench - the experiment, standalone</h2>
    <p class="mt-2 text-dim text-[0.875rem] max-w-[68ch]">
      No chat. Import a model, run the ablation, get an attributed result: naive, threads-only,
      auto - plus the optional efficiency-core arm, SUSTAINED mode (who throttles first once the
      SoC is hot) and SWEEP mode (every thread width, pinned and scheduler-placed). The device
      card's optimization grid gates on the CPU's real ISA flags:
    </p>
    <div class="mt-4 max-w-[36rem]">
      <IsaChipGrid
        legend
        chips={[
          ["i8mm gemm", false],
          ["dotprod gemm", true],
          ["sve2 kernels", false],
          ["sme", false],
          ["sme2 kleidiai", false],
          ["fp16 vector", true],
          ["kleidiai q4_0", true],
          ["big.LITTLE pin", true],
          ["adaptive threads", true],
          ["adaptive ctx", true],
          ["thermal guard", true],
          ["mmap weights", true],
          ["energy telem", true],
        ]}
      />
      <p class="mt-1 text-[0.6875rem] text-dim">The reference device's grid (Dimensity 7300): dotprod lit, i8mm dark.</p>
    </div>
    <div class="mt-6 grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
      {
        benchShots.map((s) => (
          <figure class="min-w-0">
            <PhoneFrame>
              <Shot slug={s.slug} alt={s.cap} />
            </PhoneFrame>
            <figcaption class="mt-2 text-[0.6875rem] leading-relaxed">{s.cap}</figcaption>
          </figure>
        ))
      }
    </div>
    <p class="mt-6 text-[0.8125rem] text-dim">
      Sources and build instructions: <a href={REPO}>the repository</a> &middot; contribute a
      row: <a href={withBase("/leaderboard/")}>the leaderboard</a>.
    </p>
  </section>
</Layout>
